{
  "name": "@local/dsh-fork-after-compaction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adds a Fork action below every compacted context marker so a new session starts from the compacted history.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "fork",
    "compaction"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
